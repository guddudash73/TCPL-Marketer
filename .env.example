# Safe template only. Never put real credentials in Git.

NODE_ENV=development

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=tcpl_marketer
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@localhost:5432/tcpl_marketer
DIRECT_URL=postgresql://app:app@localhost:5432/tcpl_marketer

AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
AUTH_SESSION_TTL_HOURS=8
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator
ADMIN_RESET_PASSWORD=false

OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=
OPENAI_SEARCH_CONTEXT_SIZE=low
OPENAI_EXTRACTION_MODEL=
OPENAI_GENERATION_MODEL=

APOLLO_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_PUBSUB_AUDIENCE=
GOOGLE_CLOUD_PROJECT_ID=

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

N8N_BASE_URL=http://localhost:5678
N8N_REQUEST_TIMEOUT_MS=120000
# Outbox dispatcher. Keep disabled until provider spend caps exist (PH1-03): automatic dispatch can trigger paid calls.
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_MAX_MS=900000
# Must outlast N8N_REQUEST_TIMEOUT_MS.
OUTBOX_LEASE_SECONDS=180
OUTBOX_BATCH_SIZE=5
OUTBOX_TICK_BUDGET_MS=30000
OUTBOX_HOLD_SECONDS=300
STAGE_LEASE_SECONDS=120
N8N_API_URL=http://host.docker.internal:4000
# NestJS signs a 60-second JWT with this key for each n8n webhook call. At least 32 characters.
# The same value is the passphrase of the n8n "TCPL NestJS Webhook JWT" credential (HS256).
# It is never sent over the network and is not given to the n8n container's environment.
N8N_SERVICE_SECRET=
# One signing secret per machine caller calling NestJS: at least 32 characters, all different,
# and different from N8N_SERVICE_SECRET. Generate with: openssl rand -hex 32
SERVICE_SECRET_N8N_CAMPAIGN_START=
SERVICE_SECRET_N8N_COMPANY_RESEARCH=
SERVICE_SECRET_N8N_OUTBOX_DISPATCH=
SERVICE_SECRET_INTERNAL_TOOLING=
# During a rotation, keep the old value in <NAME>_PREVIOUS until every caller uses the new one.
# Allowed clock difference for signed requests, in seconds (10 to 900).
SERVICE_AUTH_MAX_SKEW_SECONDS=300
N8N_PORT=5678
N8N_ENCRYPTION_KEY=

# Optional error reporting. Leave SENTRY_DSN empty to disable it: nothing is initialized and no
# network call is made. Events are scrubbed by the shared redactor before they leave.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Web app reporting, same rule: empty means off. Inlined into the browser bundle at build time.
NEXT_PUBLIC_SENTRY_DSN=

# Safety defaults for local/demo.
AUTOMATION_MODE_DEFAULT=MANUAL_REVIEW
EMAIL_SEND_MODE=DISABLED
EMAIL_TEST_RECIPIENT=
DAILY_EMAIL_LIMIT=10

# Provider spend caps and rate limits (PH1-03a). See docs/architecture/provider-budget.md.
# A paid provider whose API key is set (OPENAI_API_KEY, APOLLO_API_KEY) must have every variable below
# or the API refuses to start. A paid provider without them is refused at call time (CAP_NOT_CONFIGURED).
# Approved caps (PH0-02, 2026-11-23): 5 USD per day across all providers; 2 USD per run (provisional
# until the 3-company measurement run); per-campaign equals per-run. Only the owner raises a cap.
BUDGET_GLOBAL_DAY_USD=5
# OpenAI also covers web search. Amounts are USD; the estimate is reserved before each call.
BUDGET_OPENAI_RUN_USD=2
BUDGET_OPENAI_CAMPAIGN_USD=2
BUDGET_OPENAI_DAY_USD=5
OPENAI_ESTIMATE_CALL_USD=0.05
# Prices turn reported tokens into a cost. Leave a price unset and the cost is recorded as unknown
# (held at the estimate), never zero. Take the values from the OpenAI pricing page for the model in use.
OPENAI_PRICE_INPUT_PER_MILLION_USD=
OPENAI_PRICE_OUTPUT_PER_MILLION_USD=
OPENAI_WEB_SEARCH_FEE_USD=
# Apollo is counted in credits; APOLLO_USD_PER_CREDIT converts them for the global USD cap.
# Enrichment is a separate, later row; personal email and mobile requests stay disabled.
# PH0-02 set USD caps only. The credit caps and the USD value of one credit are OWNER DECISIONS still to be
# recorded; until they are set, an Apollo call is refused. The global USD cap above already bounds Apollo spend.
BUDGET_APOLLO_RUN_CREDITS=
BUDGET_APOLLO_CAMPAIGN_CREDITS=
BUDGET_APOLLO_DAY_CREDITS=
APOLLO_ESTIMATE_CALL_CREDITS=1
APOLLO_USD_PER_CREDIT=
# Crawling costs no money; optional request caps. Unset means that scope is not capped.
BUDGET_CRAWL_RUN_REQUESTS=
BUDGET_CRAWL_CAMPAIGN_REQUESTS=
BUDGET_CRAWL_DAY_REQUESTS=
# Shared across every API instance. Defaults: openai 60/min and 8 in flight, apollo 30 and 4, crawl 600 and 20.
PROVIDER_RATE_OPENAI_PER_MINUTE=60
PROVIDER_CONCURRENCY_OPENAI=8
PROVIDER_RATE_APOLLO_PER_MINUTE=30
PROVIDER_CONCURRENCY_APOLLO=4
PROVIDER_RATE_CRAWL_PER_MINUTE=600
PROVIDER_CONCURRENCY_CRAWL=20
# A reservation not settled within this time is marked EXPIRED. It stays counted and is flagged for review.
PROVIDER_RESERVATION_TTL_SECONDS=900
# A budget alert is raised once per scope and window when a cap reaches this percent (1 to 99); reaching the cap always alerts.
BUDGET_ALERT_PERCENT=80
# Website research cache: a site crawled successfully within this many days is served from its stored pages with
# no crawl and no provider budget reserved. 0 turns cache reads off; a forced refresh always crawls again.
WEBSITE_CACHE_FRESHNESS_DAYS=14
# After this many seconds a reservation no longer holds an in-flight slot (it still counts toward spend).
PROVIDER_INFLIGHT_SECONDS=300
