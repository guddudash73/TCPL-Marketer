GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_PUBSUB_AUDIENCE=
GOOGLE_CLOUD_PROJECT_ID=

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

N8N_BASE_URL=http://localhost:5678
N8N_REQUEST_TIMEOUT_MS=120000
N8N_API_URL=http://host.docker.internal:4000
N8N_SERVICE_SECRET=
N8N_PORT=5678
