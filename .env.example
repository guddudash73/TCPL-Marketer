# Safe template only. Never put real credentials in Git.

NODE_ENV=development

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=tcpl_marketer
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@localhost:5432/tcpl_marketer
DIRECT_URL=postgresql://app:app@localhost:5432/tcpl_marketer

AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
AUTH_SESSION_TTL_HOURS=8
ADMIN_EMAIL=
ADMIN_PASSWORD=
