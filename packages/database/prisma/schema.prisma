generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CampaignStatus {
  DRAFT
  STARTING
  RUNNING
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

enum CampaignAutomationMode {
  MANUAL_REVIEW
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LeadCandidateStatus {
  DISCOVERED
  VALIDATING
  RESEARCHING
  ANALYSING
  SCORING
  QUALIFIED
  REJECTED
}

enum CrawlRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum CrawlAttemptStatus {
  SUCCEEDED
  FAILED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(320)
  displayName  String?       @map("display_name") @db.VarChar(160)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles        UserRole[]
  sessions     UserSession[]
  auditLogs    AuditLog[]    @relation("AuditActor")
  campaigns    Campaign[]    @relation("CampaignCreator")

  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(64)
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(128)
  resourceType String   @map("resource_type") @db.VarChar(128)
  resourceId   String?  @map("resource_id") @db.VarChar(320)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Sector {
  id            String              @id @default(uuid()) @db.Uuid
  name          String              @db.VarChar(160)
  slug          String              @unique @db.VarChar(160)
  description   String?             @db.Text
  terminology   String[]            @default([])
  geographies   String[]            @default([])
  negativeTerms String[]            @default([]) @map("negative_terms")
  researchRules Json?               @map("research_rules")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  capabilities  ServiceCapability[]
  campaigns     Campaign[]

  @@map("sectors")
}

model ServiceCapability {
  id               String                  @id @default(uuid()) @db.Uuid
  sectorId         String                  @map("sector_id") @db.Uuid
  name             String                  @db.VarChar(160)
  slug             String                  @db.VarChar(160)
  description      String?                 @db.Text
  businessProblems String[]                @default([]) @map("business_problems")
  businessValue    String?                 @map("business_value") @db.Text
  searchGuidance   Json?                   @map("search_guidance")
  researchGuidance Json?                   @map("research_guidance")
  isActive         Boolean                 @default(true) @map("is_active")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  sector           Sector                  @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  deliverables     CapabilityDeliverable[]
  targetProfiles   TargetClientProfile[]
  decisionMakers   DecisionMakerProfile[]
  campaigns        CampaignCapability[]

  @@unique([sectorId, slug])
  @@index([sectorId, isActive])
  @@map("service_capabilities")
}

model CapabilityDeliverable {
  id           String            @id @default(uuid()) @db.Uuid
  capabilityId String            @map("capability_id") @db.Uuid
  name         String            @db.VarChar(160)
  slug         String            @db.VarChar(160)
  description  String?           @db.Text
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  capability   ServiceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  campaigns    CampaignDeliverable[]

  @@unique([capabilityId, slug])
  @@index([capabilityId, isActive])
  @@map("capability_deliverables")
}

model TargetClientProfile {
  id                         String            @id @default(uuid()) @db.Uuid
  capabilityId               String            @map("capability_id") @db.Uuid
  name                       String            @db.VarChar(160)
  slug                       String            @db.VarChar(160)
  companyCharacteristics     Json?             @map("company_characteristics")
  minimumEmployees           Int?              @map("minimum_employees")
  maximumEmployees           Int?              @map("maximum_employees")
  geographies                String[]          @default([])
  positiveTerms              String[]          @default([]) @map("positive_terms")
  negativeTerms              String[]          @default([]) @map("negative_terms")
  typicalBusinessModel       String?           @map("typical_business_model") @db.Text
  outsourcingCharacteristics String?           @map("outsourcing_characteristics") @db.Text
  isActive                   Boolean           @default(true) @map("is_active")
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  capability                 ServiceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  campaigns                  CampaignTarget[]

  @@unique([capabilityId, slug])
  @@index([capabilityId, isActive])
  @@map("target_client_profiles")
}

model DecisionMakerProfile {
  id            String            @id @default(uuid()) @db.Uuid
  capabilityId  String            @map("capability_id") @db.Uuid
  title         String            @db.VarChar(160)
  priority      Int
  seniorities   String[]          @default([])
  positiveTerms String[]          @default([]) @map("positive_terms")
  negativeTerms String[]          @default([]) @map("negative_terms")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  capability    ServiceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, title])
  @@index([capabilityId, priority])
  @@map("decision_maker_profiles")
}

model Campaign {
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String                 @db.VarChar(160)
  sectorId               String                 @map("sector_id") @db.Uuid
  createdByUserId        String                 @map("created_by_user_id") @db.Uuid
  status                 CampaignStatus         @default(DRAFT)
  automationMode         CampaignAutomationMode @default(MANUAL_REVIEW) @map("automation_mode")
  researchDepth          String                 @map("research_depth") @db.VarChar(32)
  countries              String[]               @default([])
  states                 String[]               @default([])
  cities                 String[]               @default([])
  minimumEmployees       Int?                   @map("minimum_employees")
  maximumEmployees       Int?                   @map("maximum_employees")
  targetLeadCount        Int                    @map("target_lead_count")
  minimumScore           Int                    @map("minimum_score")
  dailyEmailLimit        Int                    @map("daily_email_limit")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  sector                 Sector                 @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  createdBy              User                   @relation("CampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  capabilities           CampaignCapability[]
  deliverables           CampaignDeliverable[]
  targets                CampaignTarget[]
  sequenceSteps          CampaignSequenceStep[]
  automationRuns         AutomationRun[]
  leadCandidates         LeadCandidate[]

  @@index([status, createdAt])
  @@index([sectorId])
  @@index([createdByUserId])
  @@map("campaigns")
}

model Organization {
  id                 String          @id @default(uuid()) @db.Uuid
  name               String          @db.VarChar(240)
  normalizedName     String          @map("normalized_name") @db.VarChar(240)
  aliases            String[]        @default([])
  domain             String?         @map("domain") @db.VarChar(255)
  normalizedDomain   String?         @unique @map("normalized_domain") @db.VarChar(255)
  websiteUrl         String?         @map("website_url") @db.VarChar(2048)
  location           String          @db.VarChar(320)
  normalizedLocation String          @map("normalized_location") @db.VarChar(320)
  fallbackKey        String?         @unique @map("fallback_key") @db.VarChar(600)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  leadCandidates     LeadCandidate[]
  crawlRuns          CrawlRun[]
  sources            Source[]

  @@index([normalizedName, normalizedLocation])
  @@map("organizations")
}

model CrawlRun {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  homepageUrl    String         @map("homepage_url") @db.VarChar(2048)
  status         CrawlRunStatus @default(RUNNING)
  error          String?        @db.VarChar(500)
  startedAt      DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attempts       CrawlAttempt[]
  sources        Source[]

  @@index([organizationId, startedAt])
  @@map("crawl_runs")
}

model CrawlAttempt {
  id           String             @id @default(uuid()) @db.Uuid
  crawlRunId   String             @map("crawl_run_id") @db.Uuid
  requestedUrl String             @map("requested_url") @db.VarChar(2048)
  finalUrl     String?            @map("final_url") @db.VarChar(2048)
  method       String             @db.VarChar(16)
  status       CrawlAttemptStatus
  httpStatus   Int?               @map("http_status")
  title        String?            @db.VarChar(500)
  textLength   Int?               @map("text_length")
  error        String?            @db.VarChar(500)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  crawlRun     CrawlRun           @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  source       Source?

  @@index([crawlRunId, createdAt])
  @@map("crawl_attempts")
}

model Source {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  crawlRunId     String       @map("crawl_run_id") @db.Uuid
  crawlAttemptId String       @unique @map("crawl_attempt_id") @db.Uuid
  url            String       @db.VarChar(2048)
  title          String?      @db.VarChar(500)
  publisher      String?      @db.VarChar(255)
  sourceType     String       @map("source_type") @db.VarChar(64)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  capturedAt     DateTime     @default(now()) @map("captured_at") @db.Timestamptz(6)
  authority      String       @db.VarChar(64)
  contentHash    String       @map("content_hash") @db.Char(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  crawlRun       CrawlRun     @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  crawlAttempt   CrawlAttempt @relation(fields: [crawlAttemptId], references: [id], onDelete: Cascade)
  webDocument    WebDocument?

  @@index([organizationId, capturedAt])
  @@index([crawlRunId])
  @@index([url])
  @@map("sources")
}

model WebDocument {
  id          String   @id @default(uuid()) @db.Uuid
  sourceId    String   @unique @map("source_id") @db.Uuid
  text        String   @db.Text
  fetchMethod String  @map("fetch_method") @db.VarChar(16)
  httpStatus  Int      @map("http_status")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("web_documents")
}

model LeadCandidate {
  id                  String              @id @default(uuid()) @db.Uuid
  campaignId          String              @map("campaign_id") @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  status              LeadCandidateStatus @default(DISCOVERED)
  idempotencyKey      String              @unique @map("idempotency_key") @db.VarChar(255)
  sourceUrl           String              @map("source_url") @db.VarChar(2048)
  sourceTitle         String              @map("source_title") @db.VarChar(500)
  summary             String              @db.Text
  evidenceSnippet     String              @map("evidence_snippet") @db.Text
  searchStrategyType  String              @map("search_strategy_type") @db.VarChar(64)
  searchQuery         String              @map("search_query") @db.VarChar(500)
  discoveredAt        DateTime            @default(now()) @map("discovered_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign            Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([campaignId, organizationId])
  @@index([campaignId, status, discoveredAt])
  @@index([organizationId])
  @@map("lead_candidates")
}

model OutboxEvent {
  id                String            @id @default(uuid()) @db.Uuid
  eventType         String            @map("event_type") @db.VarChar(128)
  aggregateType     String            @map("aggregate_type") @db.VarChar(128)
  aggregateId       String            @map("aggregate_id") @db.Uuid
  idempotencyKey    String            @unique @map("idempotency_key") @db.VarChar(255)
  payload           Json
  status            OutboxEventStatus @default(PENDING)
  attempts          Int               @default(0)
  availableAt       DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  lastError         String?           @map("last_error") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(6)
  automationRun     AutomationRun?

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model AutomationRun {
  id            String              @id @default(uuid()) @db.Uuid
  campaignId    String              @map("campaign_id") @db.Uuid
  outboxEventId String              @unique @map("outbox_event_id") @db.Uuid
  provider      String              @db.VarChar(64)
  externalRunId String?             @map("external_run_id") @db.VarChar(255)
  status        AutomationRunStatus @default(PENDING)
  attempts      Int                 @default(0)
  lastError     String?             @map("last_error") @db.Text
  startedAt     DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign      Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outboxEvent   OutboxEvent         @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([status, updatedAt])
  @@map("automation_runs")
}

model CampaignCapability {
  campaignId   String            @map("campaign_id") @db.Uuid
  capabilityId String            @map("capability_id") @db.Uuid
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  capability   ServiceCapability @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@id([campaignId, capabilityId])
  @@index([capabilityId])
  @@map("campaign_capabilities")
}

model CampaignDeliverable {
  campaignId    String                @map("campaign_id") @db.Uuid
  deliverableId String                @map("deliverable_id") @db.Uuid
  campaign      Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliverable   CapabilityDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Restrict)

  @@id([campaignId, deliverableId])
  @@index([deliverableId])
  @@map("campaign_deliverables")
}

model CampaignTarget {
  campaignId            String              @map("campaign_id") @db.Uuid
  targetClientProfileId String              @map("target_client_profile_id") @db.Uuid
  campaign              Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetClientProfile   TargetClientProfile @relation(fields: [targetClientProfileId], references: [id], onDelete: Restrict)

  @@id([campaignId, targetClientProfileId])
  @@index([targetClientProfileId])
  @@map("campaign_targets")
}

model CampaignSequenceStep {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  stepNumber Int      @map("step_number")
  delayDays  Int      @map("delay_days")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, stepNumber])
  @@index([campaignId, stepNumber])
  @@map("campaign_sequence_steps")
}
