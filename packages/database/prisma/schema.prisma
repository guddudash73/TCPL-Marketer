generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CampaignStatus {
  DRAFT
  STARTING
  RUNNING
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

enum CampaignAutomationMode {
  MANUAL_REVIEW
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  PROCESSING
  DEAD_LETTER
}

enum StageName {
  DISCOVERY
  CRAWL
  RESEARCH
  EXTERNAL_INTELLIGENCE
  SCORING
  PEOPLE
  CONTACT
}

enum StageRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  REVIEW_REQUIRED
  CANCELLED
  SKIPPED
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AcceptanceDiagnosticStatus {
  CLAIMED
  VERIFIED
  NEEDS_REVIEW
}

enum LeadCandidateStatus {
  DISCOVERED
  VALIDATING
  RESEARCHING
  ANALYSING
  SCORING
  QUALIFIED
  BDE_REVIEW
  REJECTED
}

enum CrawlRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum CrawlAttemptStatus {
  SUCCEEDED
  FAILED
}

enum ClaimExtractionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum LeadGrade {
  A_PLUS_URGENT
  A
  B
  C_REVIEW
  REJECT
}

enum ScoringRecommendedAction {
  URGENT_BDE_REVIEW
  STANDARD_REVIEW
  REJECT
}

enum PersonSourceType {
  COMPANY_WEBSITE
  PUBLIC_WEB
  PROVIDER
}

enum DecisionMakerAssignmentSlot {
  PRIMARY
  SECONDARY
  FALLBACK
}

enum DecisionMakerSelectionStatus {
  COMPLETE
  REVIEW_REQUIRED
}

enum DataProvenance {
  UNKNOWN
  APPLICATION
  ACCEPTANCE_FIXTURE
  MANUALLY_REVIEWED
}

enum CompanyFitFactType {
  HEADCOUNT
  GEOGRAPHY
  BUSINESS_MODEL
}

enum CompanyFitEvidenceState {
  UNKNOWN
  VERIFIED
  CONFLICT
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(320)
  displayName  String?       @map("display_name") @db.VarChar(160)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles        UserRole[]
  sessions     UserSession[]
  auditLogs    AuditLog[]    @relation("AuditActor")
  campaigns    Campaign[]    @relation("CampaignCreator")

  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(64)
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(128)
  resourceType String   @map("resource_type") @db.VarChar(128)
  resourceId   String?  @map("resource_id") @db.VarChar(320)
  metadata     Json?
  correlationId String? @map("correlation_id") @db.VarChar(64)
  campaignId   String?  @map("campaign_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  @@index([campaignId, createdAt])
  @@map("audit_logs")
}

model Sector {
  id            String              @id @default(uuid()) @db.Uuid
  name          String              @db.VarChar(160)
  slug          String              @unique @db.VarChar(160)
  description   String?             @db.Text
  terminology   String[]            @default([])
  geographies   String[]            @default([])
  negativeTerms String[]            @default([]) @map("negative_terms")
  researchRules Json?               @map("research_rules")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  capabilities  ServiceCapability[]
  campaigns     Campaign[]

  @@map("sectors")
}

model ServiceCapability {
  id               String                  @id @default(uuid()) @db.Uuid
  sectorId         String                  @map("sector_id") @db.Uuid
  name             String                  @db.VarChar(160)
  slug             String                  @db.VarChar(160)
  description      String?                 @db.Text
  businessProblems String[]                @default([]) @map("business_problems")
  businessValue    String?                 @map("business_value") @db.Text
  searchGuidance   Json?                   @map("search_guidance")
  researchGuidance Json?                   @map("research_guidance")
  isActive         Boolean                 @default(true) @map("is_active")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  sector           Sector                  @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  deliverables     CapabilityDeliverable[]
  targetProfiles   TargetClientProfile[]
  decisionMakers   DecisionMakerProfile[]
  campaigns        CampaignCapability[]

  @@unique([sectorId, slug])
  @@index([sectorId, isActive])
  @@map("service_capabilities")
}

model CapabilityDeliverable {
  id           String            @id @default(uuid()) @db.Uuid
  capabilityId String            @map("capability_id") @db.Uuid
  name         String            @db.VarChar(160)
  slug         String            @db.VarChar(160)
  description  String?           @db.Text
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  capability   ServiceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  campaigns    CampaignDeliverable[]

  @@unique([capabilityId, slug])
  @@index([capabilityId, isActive])
  @@map("capability_deliverables")
}

model TargetClientProfile {
  id                         String            @id @default(uuid()) @db.Uuid
  capabilityId               String            @map("capability_id") @db.Uuid
  name                       String            @db.VarChar(160)
  slug                       String            @db.VarChar(160)
  companyCharacteristics     Json?             @map("company_characteristics")
  minimumEmployees           Int?              @map("minimum_employees")
  maximumEmployees           Int?              @map("maximum_employees")
  geographies                String[]          @default([])
  positiveTerms              String[]          @default([]) @map("positive_terms")
  negativeTerms              String[]          @default([]) @map("negative_terms")
  typicalBusinessModel       String?           @map("typical_business_model") @db.Text
  outsourcingCharacteristics String?           @map("outsourcing_characteristics") @db.Text
  isActive                   Boolean           @default(true) @map("is_active")
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  capability                 ServiceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  campaigns                  CampaignTarget[]

  @@unique([capabilityId, slug])
  @@index([capabilityId, isActive])
  @@map("target_client_profiles")
}

model DecisionMakerProfile {
  id            String            @id @default(uuid()) @db.Uuid
  capabilityId  String            @map("capability_id") @db.Uuid
  title         String            @db.VarChar(160)
  priority      Int
  seniorities   String[]          @default([])
  positiveTerms String[]          @default([]) @map("positive_terms")
  negativeTerms String[]          @default([]) @map("negative_terms")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  capability    ServiceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  assignments   DecisionMakerAssignment[]

  @@unique([capabilityId, title])
  @@index([capabilityId, priority])
  @@map("decision_maker_profiles")
}

model Campaign {
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String                 @db.VarChar(160)
  provenance             DataProvenance         @default(UNKNOWN)
  sectorId               String                 @map("sector_id") @db.Uuid
  createdByUserId        String                 @map("created_by_user_id") @db.Uuid
  status                 CampaignStatus         @default(DRAFT)
  automationMode         CampaignAutomationMode @default(MANUAL_REVIEW) @map("automation_mode")
  researchDepth          String                 @map("research_depth") @db.VarChar(32)
  countries              String[]               @default([])
  states                 String[]               @default([])
  cities                 String[]               @default([])
  minimumEmployees       Int?                   @map("minimum_employees")
  maximumEmployees       Int?                   @map("maximum_employees")
  targetLeadCount        Int                    @map("target_lead_count")
  minimumScore           Int                    @map("minimum_score")
  sectorFitWeight        Int                    @default(15) @map("sector_fit_weight")
  capabilityMatchWeight  Int                    @default(20) @map("capability_match_weight")
  targetClientFitWeight  Int                    @default(15) @map("target_client_fit_weight")
  outsourcingWeight      Int                    @default(15) @map("outsourcing_weight")
  buyingIntentWeight     Int                    @default(20) @map("buying_intent_weight")
  businessMomentumWeight Int                    @default(5) @map("business_momentum_weight")
  decisionMakerWeight    Int                    @default(5) @map("decision_maker_weight")
  contactConfidenceWeight Int                   @default(5) @map("contact_confidence_weight")
  dailyEmailLimit        Int                    @map("daily_email_limit")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  sector                 Sector                 @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  createdBy              User                   @relation("CampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  capabilities           CampaignCapability[]
  deliverables           CampaignDeliverable[]
  targets                CampaignTarget[]
  sequenceSteps          CampaignSequenceStep[]
  automationRuns         AutomationRun[]
  stageRuns              StageRun[]
  leadCandidates         LeadCandidate[]

  @@index([status, createdAt])
  @@index([sectorId])
  @@index([createdByUserId])
  @@map("campaigns")
}

model Organization {
  id                 String          @id @default(uuid()) @db.Uuid
  name               String          @db.VarChar(240)
  normalizedName     String          @map("normalized_name") @db.VarChar(240)
  aliases            String[]        @default([])
  domain             String?         @map("domain") @db.VarChar(255)
  normalizedDomain   String?         @unique @map("normalized_domain") @db.VarChar(255)
  websiteUrl         String?         @map("website_url") @db.VarChar(2048)
  location           String          @db.VarChar(320)
  normalizedLocation String          @map("normalized_location") @db.VarChar(320)
  fallbackKey        String?         @unique @map("fallback_key") @db.VarChar(600)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  leadCandidates     LeadCandidate[]
  crawlRuns          CrawlRun[]
  sources            Source[]
  claimExtractionRuns ClaimExtractionRun[]
  claims              Claim[]
  companyFitObservations CompanyFitObservation[]
  people              Person[]

  @@index([normalizedName, normalizedLocation])
  @@map("organizations")
}

model CrawlRun {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  homepageUrl    String         @map("homepage_url") @db.VarChar(2048)
  status         CrawlRunStatus @default(RUNNING)
  error          String?        @db.VarChar(500)
  startedAt      DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attempts       CrawlAttempt[]
  sources        Source[]

  @@index([organizationId, startedAt])
  @@map("crawl_runs")
}

model CrawlAttempt {
  id           String             @id @default(uuid()) @db.Uuid
  crawlRunId   String             @map("crawl_run_id") @db.Uuid
  requestedUrl String             @map("requested_url") @db.VarChar(2048)
  finalUrl     String?            @map("final_url") @db.VarChar(2048)
  method       String             @db.VarChar(16)
  status       CrawlAttemptStatus
  httpStatus   Int?               @map("http_status")
  title        String?            @db.VarChar(500)
  textLength   Int?               @map("text_length")
  error        String?            @db.VarChar(500)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  crawlRun     CrawlRun           @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  source       Source?

  @@index([crawlRunId, createdAt])
  @@map("crawl_attempts")
}

model Source {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  crawlRunId     String       @map("crawl_run_id") @db.Uuid
  crawlAttemptId String       @unique @map("crawl_attempt_id") @db.Uuid
  url            String       @db.VarChar(2048)
  title          String?      @db.VarChar(500)
  publisher      String?      @db.VarChar(255)
  sourceType     String       @map("source_type") @db.VarChar(64)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  capturedAt     DateTime     @default(now()) @map("captured_at") @db.Timestamptz(6)
  authority      String       @db.VarChar(64)
  contentHash    String       @map("content_hash") @db.Char(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  crawlRun       CrawlRun     @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  crawlAttempt   CrawlAttempt @relation(fields: [crawlAttemptId], references: [id], onDelete: Cascade)
  webDocument    WebDocument?
  claimEvidence  ClaimEvidence[]
  companyFitObservations CompanyFitObservation[]

  @@index([organizationId, capturedAt])
  @@index([crawlRunId])
  @@index([url])
  @@map("sources")
}

model CompanyFitObservation {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  factType       CompanyFitFactType      @map("fact_type")
  state          CompanyFitEvidenceState
  headcountMin   Int?                    @map("headcount_min")
  headcountMax   Int?                    @map("headcount_max")
  textValue      String?                 @map("text_value") @db.VarChar(500)
  sourceId       String?                 @map("source_id") @db.Uuid
  capturedAt     DateTime?               @map("captured_at") @db.Timestamptz(6)
  confidence     Float?
  evidenceExcerpt String?                @map("evidence_excerpt") @db.Text
  conflictingSourceIds String[]          @default([]) @map("conflicting_source_ids") @db.Uuid
  extractionRunId String?                @map("extraction_run_id") @db.Uuid
  fingerprint    String                  @unique @db.Char(64)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  source         Source?                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  extractionRun  ClaimExtractionRun?     @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)

  @@index([organizationId, factType, state])
  @@index([sourceId])
  @@index([extractionRunId])
  @@map("company_fit_observations")
}

model WebDocument {
  id          String   @id @default(uuid()) @db.Uuid
  sourceId    String   @unique @map("source_id") @db.Uuid
  text        String   @db.Text
  fetchMethod String  @map("fetch_method") @db.VarChar(16)
  httpStatus  Int      @map("http_status")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("web_documents")
}

model ClaimExtractionRun {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  idempotencyKey     String                   @unique @map("idempotency_key") @db.Char(64)
  documentSetHash    String                   @map("document_set_hash") @db.Char(64)
  provider           String                   @db.VarChar(64)
  model              String                   @db.VarChar(128)
  promptName         String                   @map("prompt_name") @db.VarChar(128)
  promptVersion      String                   @map("prompt_version") @db.VarChar(64)
  status             ClaimExtractionRunStatus @default(RUNNING)
  providerResponseId String?                  @map("provider_response_id") @db.VarChar(255)
  inputTokens        Int?                     @map("input_tokens")
  outputTokens       Int?                     @map("output_tokens")
  totalTokens        Int?                     @map("total_tokens")
  error              String?                  @db.VarChar(500)
  startedAt          DateTime                 @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz(6)
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  claims             Claim[]
  companyFitObservations CompanyFitObservation[]
  leadScores         LeadScore[]

  @@index([organizationId, status, startedAt])
  @@map("claim_extraction_runs")
}

model Claim {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  extractionRunId String             @map("extraction_run_id") @db.Uuid
  claimType       String             @map("claim_type") @db.VarChar(64)
  statement       String             @db.Text
  fingerprint     String             @db.Char(64)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  extractionRun   ClaimExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  evidence        ClaimEvidence[]

  @@unique([extractionRunId, fingerprint])
  @@index([organizationId, claimType])
  @@map("claims")
}

model ClaimEvidence {
  claimId  String @map("claim_id") @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  claim    Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([claimId, sourceId])
  @@index([sourceId])
  @@map("claim_evidence")
}

model LeadCandidate {
  id                  String              @id @default(uuid()) @db.Uuid
  provenance          DataProvenance      @default(UNKNOWN)
  campaignId          String              @map("campaign_id") @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  status              LeadCandidateStatus @default(DISCOVERED)
  idempotencyKey      String              @unique @map("idempotency_key") @db.VarChar(255)
  sourceUrl           String              @map("source_url") @db.VarChar(2048)
  sourceTitle         String              @map("source_title") @db.VarChar(500)
  summary             String              @db.Text
  evidenceSnippet     String              @map("evidence_snippet") @db.Text
  searchStrategyType  String              @map("search_strategy_type") @db.VarChar(64)
  searchQuery         String              @map("search_query") @db.VarChar(500)
  discoveredAt        DateTime            @default(now()) @map("discovered_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign            Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scores              LeadScore[]
  decisionMakerSelections DecisionMakerSelection[]
  acceptanceDiagnosticRuns AcceptanceDiagnosticRun[]

  @@unique([campaignId, organizationId])
  @@index([campaignId, status, discoveredAt])
  @@index([organizationId])
  @@map("lead_candidates")
}

model AcceptanceDiagnosticRun {
  id              String                     @id @default(uuid()) @db.Uuid
  leadCandidateId String                     @unique @map("lead_candidate_id") @db.Uuid
  campaignId      String                     @map("campaign_id") @db.Uuid
  focus           String                     @db.VarChar(16)
  inputHash       String                     @map("input_hash") @db.Char(64)
  candidateUpdatedAt DateTime                @map("candidate_updated_at") @db.Timestamptz(6)
  status          AcceptanceDiagnosticStatus @default(CLAIMED)
  externalRunId   String?                    @map("external_run_id") @db.VarChar(255)
  scoreId         String?                    @map("score_id") @db.Uuid
  outcome         String?                    @db.VarChar(128)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt     DateTime?                  @map("completed_at") @db.Timestamptz(6)
  leadCandidate   LeadCandidate              @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("acceptance_diagnostic_runs")
}

model LeadScore {
  id                    String                   @id @default(uuid()) @db.Uuid
  leadCandidateId       String                   @map("lead_candidate_id") @db.Uuid
  claimExtractionRunId  String                   @map("claim_extraction_run_id") @db.Uuid
  idempotencyKey        String                   @unique @map("idempotency_key") @db.Char(64)
  score                 Int
  needScore             Int                      @map("need_score")
  intentScore           Int                      @map("intent_score")
  grade                 LeadGrade
  qualified             Boolean
  recommendedAction     ScoringRecommendedAction @map("recommended_action")
  minimumScore          Int                      @map("minimum_score")
  weights               Json
  components            Json
  reasons               String[]
  evidenceIds           String[]                 @map("evidence_ids") @db.Uuid
  highIntentOverride    Json                     @map("high_intent_override")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  leadCandidate         LeadCandidate            @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)
  claimExtractionRun    ClaimExtractionRun       @relation(fields: [claimExtractionRunId], references: [id], onDelete: Restrict)

  @@index([leadCandidateId, createdAt])
  @@index([claimExtractionRunId])
  @@index([grade, qualified, createdAt])
  @@map("lead_scores")
}

model Person {
  id               String           @id @default(uuid()) @db.Uuid
  provenance       DataProvenance   @default(UNKNOWN)
  organizationId   String           @map("organization_id") @db.Uuid
  idempotencyKey   String           @unique @map("idempotency_key") @db.Char(64)
  fullName         String           @map("full_name") @db.VarChar(240)
  normalizedName   String           @map("normalized_name") @db.VarChar(240)
  location         String?          @db.VarChar(320)
  profileUrl       String?          @map("profile_url") @db.VarChar(2048)
  sourceType       PersonSourceType @map("source_type")
  sourceProvider   String           @map("source_provider") @db.VarChar(64)
  sourcePersonId   String?          @map("source_person_id") @db.VarChar(255)
  sourceUrl        String?          @map("source_url") @db.VarChar(2048)
  confidence       Float
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles            PersonRole[]
  decisionMakerAssignments DecisionMakerAssignment[]

  @@index([organizationId, normalizedName])
  @@index([sourceProvider, sourcePersonId])
  @@map("people")
}

model PersonRole {
  id              String   @id @default(uuid()) @db.Uuid
  personId        String   @map("person_id") @db.Uuid
  idempotencyKey  String   @unique @map("idempotency_key") @db.Char(64)
  title           String   @db.VarChar(240)
  normalizedTitle String   @map("normalized_title") @db.VarChar(240)
  seniority       String?  @db.VarChar(80)
  departments     String[] @default([])
  isCurrent       Boolean  @default(true) @map("is_current")
  sourceUrl       String?  @map("source_url") @db.VarChar(2048)
  confidence      Float
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  decisionMakerAssignments DecisionMakerAssignment[]

  @@index([personId, isCurrent])
  @@index([normalizedTitle])
  @@map("person_roles")
}

model DecisionMakerSelection {
  id              String                    @id @default(uuid()) @db.Uuid
  leadCandidateId String                    @map("lead_candidate_id") @db.Uuid
  idempotencyKey  String                    @unique @map("idempotency_key") @db.Char(64)
  status          DecisionMakerSelectionStatus @default(REVIEW_REQUIRED)
  warnings        String[]                  @default([])
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  leadCandidate   LeadCandidate             @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)
  assignments     DecisionMakerAssignment[]

  @@index([leadCandidateId, createdAt])
  @@map("decision_maker_selections")
}

model DecisionMakerAssignment {
  id                     String                      @id @default(uuid()) @db.Uuid
  selectionId            String                      @map("selection_id") @db.Uuid
  personId               String                      @map("person_id") @db.Uuid
  personRoleId           String                      @map("person_role_id") @db.Uuid
  decisionMakerProfileId String                      @map("decision_maker_profile_id") @db.Uuid
  slot                   DecisionMakerAssignmentSlot
  rankScore              Int                         @map("rank_score")
  components             Json
  reasons                String[]
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  selection              DecisionMakerSelection      @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  person                 Person                      @relation(fields: [personId], references: [id], onDelete: Cascade)
  personRole             PersonRole                  @relation(fields: [personRoleId], references: [id], onDelete: Cascade)
  decisionMakerProfile   DecisionMakerProfile        @relation(fields: [decisionMakerProfileId], references: [id], onDelete: Restrict)

  @@unique([selectionId, slot])
  @@unique([selectionId, personId])
  @@index([personId])
  @@index([decisionMakerProfileId])
  @@map("decision_maker_assignments")
}

model OutboxEvent {
  id                String            @id @default(uuid()) @db.Uuid
  eventType         String            @map("event_type") @db.VarChar(128)
  aggregateType     String            @map("aggregate_type") @db.VarChar(128)
  aggregateId       String            @map("aggregate_id") @db.Uuid
  idempotencyKey    String            @unique @map("idempotency_key") @db.VarChar(255)
  payload           Json
  status            OutboxEventStatus @default(PENDING)
  attempts          Int               @default(0)
  availableAt       DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  lastError         String?           @map("last_error") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(6)
  leaseOwner        String?           @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt    DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  deadLetteredAt    DateTime?         @map("dead_lettered_at") @db.Timestamptz(6)
  correlationId     String?           @map("correlation_id") @db.VarChar(64)
  automationRun     AutomationRun?

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

/// One accepted signed service request. A repeated request ID is a replay.
model ServiceRequestNonce {
  callerId  String   @map("caller_id") @db.VarChar(64)
  requestId String   @map("request_id") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([callerId, requestId])
  @@index([expiresAt])
  @@map("service_request_nonces")
}

model AutomationRun {
  id            String              @id @default(uuid()) @db.Uuid
  campaignId    String              @map("campaign_id") @db.Uuid
  outboxEventId String              @unique @map("outbox_event_id") @db.Uuid
  provider      String              @db.VarChar(64)
  externalRunId String?             @map("external_run_id") @db.VarChar(255)
  status        AutomationRunStatus @default(PENDING)
  attempts      Int                 @default(0)
  lastError     String?             @map("last_error") @db.Text
  startedAt     DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign      Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outboxEvent   OutboxEvent         @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([status, updatedAt])
  @@map("automation_runs")
}

model StageRun {
  id             String         @id @default(uuid()) @db.Uuid
  campaignId     String         @map("campaign_id") @db.Uuid
  entityType     String         @map("entity_type") @db.VarChar(64)
  entityId       String         @map("entity_id") @db.Uuid
  stage          StageName
  inputHash      String         @map("input_hash") @db.Char(64)
  status         StageRunStatus @default(PENDING)
  attempt        Int            @default(0)
  leaseOwner     String?        @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt DateTime?      @map("lease_expires_at") @db.Timestamptz(6)
  lastHeartbeatAt DateTime?     @map("last_heartbeat_at") @db.Timestamptz(6)
  lastError      String?        @map("last_error") @db.Text
  outcome        String?        @db.VarChar(128)
  outcomeReason  String?        @map("outcome_reason") @db.Text
  result         Json?
  correlationId  String?        @map("correlation_id") @db.VarChar(64)
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, stage, inputHash])
  @@index([campaignId, stage, status])
  @@index([status, leaseExpiresAt])
  @@map("stage_runs")
}

model CampaignCapability {
  campaignId   String            @map("campaign_id") @db.Uuid
  capabilityId String            @map("capability_id") @db.Uuid
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  capability   ServiceCapability @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@id([campaignId, capabilityId])
  @@index([capabilityId])
  @@map("campaign_capabilities")
}

model CampaignDeliverable {
  campaignId    String                @map("campaign_id") @db.Uuid
  deliverableId String                @map("deliverable_id") @db.Uuid
  campaign      Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliverable   CapabilityDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Restrict)

  @@id([campaignId, deliverableId])
  @@index([deliverableId])
  @@map("campaign_deliverables")
}

model CampaignTarget {
  campaignId            String              @map("campaign_id") @db.Uuid
  targetClientProfileId String              @map("target_client_profile_id") @db.Uuid
  campaign              Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetClientProfile   TargetClientProfile @relation(fields: [targetClientProfileId], references: [id], onDelete: Restrict)

  @@id([campaignId, targetClientProfileId])
  @@index([targetClientProfileId])
  @@map("campaign_targets")
}

model CampaignSequenceStep {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  stepNumber Int      @map("step_number")
  delayDays  Int      @map("delay_days")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, stepNumber])
  @@index([campaignId, stepNumber])
  @@map("campaign_sequence_steps")
}
