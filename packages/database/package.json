{
  "name": "@tcpl-marketer/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "smoke": "node --env-file-if-exists=../../.env src/query-smoke.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "verify": "prisma validate && prisma generate && tsc --noEmit && node --env-file-if-exists=../../.env src/query-smoke.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}
