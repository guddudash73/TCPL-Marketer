{
  "name": "@tcpl-marketer/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "validate": "prisma validate",
    "smoke": "node --env-file-if-exists=../../.env src/query-smoke.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "verify": "prisma validate && prisma generate && tsc --noEmit && node --env-file-if-exists=../../.env src/query-smoke.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
