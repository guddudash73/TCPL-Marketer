{
  "name": "@tcpl-marketer/provider-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @tcpl-marketer/ai-contracts build",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "pretypecheck": "pnpm --filter @tcpl-marketer/ai-contracts build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tcpl-marketer/ai-contracts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.13.5",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "9.39.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
